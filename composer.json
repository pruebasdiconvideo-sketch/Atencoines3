{
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-sqlsrv": "*",
        "minishlink/web-push": "^8.0",
        "phpoffice/phpspreadsheet": "^2.0"
    },
    "config": {
        "platform": { "php": "8.1" },
        "optimize-autoloader": true,
        "classmap-authoritative": false
    },
    "scripts": {
        "post-install-cmd": [
            "php -r \"file_exists('config/vapid.json') || file_put_contents('config/vapid.json', '{}');\"",
            "php -r \"is_dir('storage/exports') || mkdir('storage/exports', 0775, true);\"",
            "php -r \"is_dir('storage/logs') || mkdir('storage/logs', 0775, true);\""
        ]
    }
}
